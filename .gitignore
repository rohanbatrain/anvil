__pycache__/
*.py[cod]
.venv/
venv/
# Every .env variant is a secret, including backups and per-host copies. The
# original pattern covered .env and .env.local only, which meant a file named
# .env.backup-20260904 sat untracked-but-not-ignored, one `git add -A` away
# from being published.
.env
.env.*
!.env.example
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
.next/
out/
.DS_Store
*.db
*.sqlite3
artifacts/

# .mcp.json is committed on purpose: it interpolates ${RAZORPAY_MCP_TOKEN} from
# the environment and contains no secret. If you ever inline a token there,
# uncomment the next line and rotate the key.
# .mcp.json
