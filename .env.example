# ---------------------------------------------------------------------------
# Anvil. Every value below has a working default. Offline mode needs NO keys.
# ---------------------------------------------------------------------------
ANVIL_MODE=offline                  # offline | live
ANVIL_ENV=local
ANVIL_LOG_LEVEL=INFO
ANVIL_LOG_FORMAT=console            # console | json

ANVIL_DATABASE_URL=postgresql+asyncpg://anvil:anvil@localhost:5432/anvil
ANVIL_REDIS_URL=redis://localhost:6379/0

# Deterministic seed. The same seed reproduces the same batch, byte for byte.
ANVIL_SEED=20260902

# --- Live mode only. Leave blank for offline. ------------------------------
ANVIL_RAZORPAY_KEY_ID=
ANVIL_RAZORPAY_KEY_SECRET=
ANVIL_RAZORPAY_WEBHOOK_SECRET=
ANVIL_ANTHROPIC_API_KEY=

# --- Models -----------------------------------------------------------------
ANVIL_MODEL_PLANNER=claude-opus-5
ANVIL_MODEL_CLASSIFIER=claude-sonnet-5
ANVIL_MODEL_COMPOSER=claude-sonnet-5

# --- Guardrails -------------------------------------------------------------
ANVIL_WEBHOOK_TOLERANCE_SECONDS=300
ANVIL_LLM_MAX_RETRIES=3
ANVIL_LLM_TIMEOUT_SECONDS=60
